# Optional. Defaults are ad / 6a01 if these are omitted.
ADMIN_USER=ad
ADMIN_PASSWORD=6a01

# Set a long random string on Vercel so session cookies cannot be forged.
AUTH_SECRET=replace-with-a-long-random-string

# Created automatically when you connect a Blob store in the Vercel project.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
# Leave unset for a public store. Set private only when the store itself is private.
# BLOB_ACCESS=public
